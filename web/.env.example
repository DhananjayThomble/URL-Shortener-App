# Base URL of the NestJS API. No API routes are served from this Next.js app.
#
# REQUIRED for a production build. next.config.ts refuses to build without it,
# and rejects a localhost value — otherwise every visitor's browser would try
# to call their own machine.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Serve the UI from in-repo fixtures instead of the network.
#
# Opt-IN, and only useful for frontend work with no backend running. A
# production build with this set to "true" is rejected: fixtures are invented
# data, and a site serving them looks completely functional while being
# entirely fake.
#
# Leave unset to talk to the real API.
# NEXT_PUBLIC_USE_FIXTURES=true

# Google sign-in on /login and /register. Optional — the button only renders
# when this is set. Must be the same client id as the API's
# GOOGLE_OAUTH_CLIENT_ID, or ID tokens this app requests will fail the API's
# audience check.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Error tracking (Sentry, optional, #995). OFF unless NEXT_PUBLIC_SENTRY_DSN is
# set: with no DSN the SDK never initialises and the browser sends nothing.
# NEXT_PUBLIC_* values are baked at build time. Self-hosted Sentry works too.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Release tag on every event (version or commit). Optional.
# NEXT_PUBLIC_SENTRY_RELEASE=snapurl@2.0.0
# Environment tag; defaults to NODE_ENV when unset.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Errors sample rate 0..1 (default 1). Traces sample rate 0..1 (default 0).
# NEXT_PUBLIC_SENTRY_ERRORS_SAMPLE_RATE=1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
#
# Source-map upload (CI only). When SENTRY_AUTH_TOKEN is present at build time,
# `next build` uploads browser source maps to Sentry so stack traces are
# un-minified; absent, the build skips the upload cleanly. SENTRY_ORG and
# SENTRY_PROJECT name the destination. These are CI/build secrets, never shipped
# to the browser (no NEXT_PUBLIC_ prefix).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
