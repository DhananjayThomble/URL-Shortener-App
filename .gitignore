.vscode/*
.env
node_modules/
resources/
extras/todo
.idea
# Local Netlify folder
.netlify
package-lock.json
yarn.lock
npm-debug.log
yarn-error.log
build/
dist/
.db
.vscode/
.idea/
.DS_Store
.next
# SnapURL 2.0 monorepo
.env
.env.local
!.env.example
.env.staging
!.env.staging.example
dist/
logs/
*.tsbuildinfo

# Background-agent worktrees are local scratch, never part of the repo.
.claude/worktrees/

# Vercel CLI project link — local machine state, not repo state.
.vercel

# Project-scoped GitHub token, read by `gh` via GH_TOKEN. Local credential,
# never repo state. Listed here rather than only in .git/info/exclude so a
# contributor following the same convention is protected too.
.gh-token

# QA run scratch: screenshots, HAR/DOM dumps, driver logs and raw findings.
# Large and machine-generated — the distilled report is what gets committed,
# never the artifacts. Sessions also mint real staging tokens into these dirs.
.qa-runs/
.staging-qa/
.mobile-audit/
.mobile-audit-build.log

# Autopilot transcripts, its local kill switch and engine state (scripts/agents/autopilot.sh).
.agent-logs/
.agents-paused
.agent-state/
# Shared agent memory from the private ops repo, symlinked in by its tools/link-shared-context.sh.
.kiro/steering/shared-memory-*
# Local IDE/LSP state some tool configs generate on demand; not part of the repo's own config.
# Left untracked here would otherwise sit in the pinned checkout as a perpetually dirty/untracked
# path (issue #523) — gitignoring it means a fresh clone or restart never has to care.
.kiro/settings/lsp.json

# Agent track-coordination markers (e.g. EXT-R3.done). Local handoff state.
*.done

# Internal agent task-state (planning artifacts, not product code)
.tasks/
.agents/

# Coverage output (issue #355) — generated, never committed
coverage/
**/coverage/
