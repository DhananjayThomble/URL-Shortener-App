# Single-node production configuration contract.
#
# Copy this to .env and fill in the domains. The blank secret fields
# (POSTGRES_PASSWORD, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET) are generated for
# you by ./init.sh — do NOT put real secret values in this example file.
#
#   ./init.sh          # copies this to .env and fills the blanks
#   $EDITOR .env       # set APP_DOMAIN / SHORT_DOMAIN / ACME_EMAIL
#
# Nothing here has a working default for a secret or a localhost origin: this
# is a production template.

# --- Domains --------------------------------------------------------------
# APP_DOMAIN serves the dashboard + API; SHORT_DOMAIN serves the short links.
# Both need public DNS records pointing at this host so Caddy can get TLS certs.
APP_DOMAIN=app.example.com
SHORT_DOMAIN=snap.example.com

# ACME contact email for Let's Encrypt (optional but recommended so the CA can
# warn you about expiries). Leave blank to skip.
ACME_EMAIL=

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=snapurl
POSTGRES_DB=snapurl
# Generated by init.sh. Leave blank; do not commit a real password.
POSTGRES_PASSWORD=

# --- Secrets --------------------------------------------------------------
# Generated by init.sh (openssl rand -hex 32 -> 64 hex chars each). Leave blank.
#
# Requirements enforced downstream:
#   * Each must be >= 32 characters or the API's zod schema fails fast at boot.
#   * JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST differ.
#   * The API and the redirect service MUST share the SAME JWT_ACCESS_SECRET —
#     the redirect verifies unlock tokens the API signed. The compose file
#     already wires the one variable into both, so just keep it consistent.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Images / behaviour ---------------------------------------------------
# Which published image tag to run. Pin to a release (e.g. v2.0.0) in
# production; `latest` follows the newest published build.
SNAPURL_TAG=latest

# Mail transport. `outbox` writes each message to a file in a local outbox
# directory (os.tmpdir()/snapurl-outbox by default, override with
# MAIL_OUTBOX_DIR) instead of sending it. On this compose that directory lives
# inside the api container's filesystem, so it is ephemeral unless you mount a
# volume for it; a real deployment configures SES or another transport instead.
MAIL_TRANSPORT=outbox

# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Optional / advanced (uncomment only if you need them) ----------------
# These are documented in SELF-HOSTING.md. The single-node profile runs
# correctly on the defaults shown, so leave them commented out unless a section
# of the guide tells you to set one. They are listed here so the guide and this
# file stay in step (scripts/check-selfhost-env.mjs enforces that).
#
# Where mail written by the `outbox` transport lands inside the api container
# (default: the OS temp dir). Mount a volume at this path to keep it.
# MAIL_OUTBOX_DIR=/data/outbox
#
# CORS origin(s) for the browser extension, comma-separated. Empty keeps CORS
# locked to the dashboard origin. See apps/extension/README.md.
# EXTENSION_ORIGINS=chrome-extension://<id>
#
# Cache backend. The single-node profile uses the in-process cache; leave this
# unset (defaults to `memory`). `redis` is for the horizontally-scaled profile.
# CACHE_DRIVER=memory
#
# How many reverse-proxy hops to trust for the client IP. Caddy is the single
# proxy in front of the stack, so the default of 1 is correct here.
# TRUSTED_PROXY_HOPS=1
#
# --- Retention (worker) ---------------------------------------------------
# How long raw per-click rows are kept, install-wide. The rollups the
# dashboards read are kept regardless. See SELF-HOSTING.md "Retention".
# CLICK_EVENTS_RETENTION_YEARS=3
# A hard ceiling on attached day-partitions, independent of the age window.
# CLICK_EVENTS_MAX_RETAINED_DAYS=1100
# Chunk size for the one-time historical-partition backfill routine.
# CLICK_EVENTS_BACKFILL_CHUNK_DAYS=200
