# Single-node production configuration contract.
#
# Copy this to .env and fill in the domains. The blank secret fields
# (POSTGRES_PASSWORD, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET) are generated for
# you by ./init.sh — do NOT put real secret values in this example file.
#
#   ./init.sh          # copies this to .env and fills the blanks
#   $EDITOR .env       # set APP_DOMAIN / SHORT_DOMAIN / ACME_EMAIL
#
# Nothing here has a working default for a secret or a localhost origin: this
# is a production template.

# --- Domains --------------------------------------------------------------
# APP_DOMAIN serves the dashboard + API; SHORT_DOMAIN serves the short links.
# Both need public DNS records pointing at this host so Caddy can get TLS certs.
APP_DOMAIN=app.example.com
SHORT_DOMAIN=snap.example.com

# ACME contact email for Let's Encrypt (optional but recommended so the CA can
# warn you about expiries). Leave blank to skip.
ACME_EMAIL=

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=snapurl
POSTGRES_DB=snapurl
# Generated by init.sh. Leave blank; do not commit a real password.
POSTGRES_PASSWORD=

# --- Secrets --------------------------------------------------------------
# Generated by init.sh (openssl rand -hex 32 -> 64 hex chars each). Leave blank.
#
# Requirements enforced downstream:
#   * Each must be >= 32 characters or the API's zod schema fails fast at boot.
#   * JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST differ.
#   * The API and the redirect service MUST share the SAME JWT_ACCESS_SECRET —
#     the redirect verifies unlock tokens the API signed. The compose file
#     already wires the one variable into both, so just keep it consistent.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Images / behaviour ---------------------------------------------------
# Which published image tag to run. Pin to a release (e.g. v2.0.0) in
# production; `latest` follows the newest published build.
SNAPURL_TAG=latest

# Mail transport. `outbox` records mail to the database without sending.
MAIL_TRANSPORT=outbox

# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info
