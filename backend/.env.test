# Test Environment Configuration
NODE_ENV=test

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_db

# Test Database Configuration (separate instances for testing)
POSTGRES_TEST_HOST=localhost
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=password
POSTGRES_TEST_DB=url_shortener_test

MONGODB_URI=mongodb://localhost:27017/test_db
MONGODB_TEST_URI=mongodb://localhost:27018/url_shortener_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Test Redis Configuration
REDIS_TEST_HOST=localhost
REDIS_TEST_PORT=6380
REDIS_TEST_PASSWORD=

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=10

# Email Configuration
EMAIL_FROM=test@example.com
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=test
EMAIL_PASSWORD=test

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000
KEEP_ALIVE_TIMEOUT=5000
HEADERS_TIMEOUT=6000

# External Services
GEOIP_API_KEY=test-geoip-key
GEOIP_API_URL=https://api.test-geoip.com

# Monitoring
PROMETHEUS_ENABLED=false
JAEGER_ENABLED=false

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads/test

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_ITEMS=1000

# Logging
LOG_LEVEL=error
LOG_FORMAT=json

# Testing Specific
TEST_TIMEOUT=30000
TEST_DATABASE_RESET=true