{
  "name": "nestjs-url-shortener",
  "version": "1.0.0",
  "description": "Enterprise URL Shortener built with NestJS v10",
  "author": "URL Shortener Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "quality:check": "npm run lint:check && npm run format:check && npm run test:ci",
    "quality:fix": "npm run lint:fix && npm run format",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:property": "jest --selectProjects property",
    "test:performance": "cross-env NODE_ENV=test jest --config ./test/jest-performance.json --runInBand --verbose",
    "test:load": "cross-env NODE_ENV=test jest --config ./test/jest-performance.json --testPathPattern=\"load-testing\" --runInBand",
    "test:benchmark": "cross-env NODE_ENV=test jest --config ./test/jest-performance.json --testPathPattern=\"benchmark\" --runInBand",
    "test:stress": "cross-env NODE_ENV=test jest --config ./test/jest-performance.json --testPathPattern=\"stress-testing\" --runInBand",
    "test:security": "cross-env NODE_ENV=test jest --config ./test/jest-security.json --runInBand --verbose",
    "test:security:auth": "cross-env NODE_ENV=test jest --config ./test/jest-security.json --testPathPattern=\"authentication-security\" --runInBand",
    "test:security:input": "cross-env NODE_ENV=test jest --config ./test/jest-security.json --testPathPattern=\"input-validation-security\" --runInBand",
    "test:security:pentest": "cross-env NODE_ENV=test jest --config ./test/jest-security.json --testPathPattern=\"penetration-testing\" --runInBand",
    "test:all": "jest --selectProjects unit integration e2e property",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:prod-ready": "node test-production-readiness.js",
    "test:simple": "node test-simple.js",
    "validate:env": "node validate-env.js",
    "setup:dev": "bash scripts/setup-dev.sh",
    "setup:dev:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "setup:hooks:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-git-hooks.ps1",
    "seed:db": "node scripts/seed-database.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "db:health": "node scripts/db-health-check.js",
    "migration:manage": "node scripts/migration-manager.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/typeorm.config.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/typeorm.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/typeorm.config.ts"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^5.0.1",
    "@nestjs/typeorm": "^10.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@opentelemetry/exporter-jaeger": "^2.2.0",
    "@opentelemetry/exporter-prometheus": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@types/joi": "^17.2.2",
    "@types/nodemailer": "^7.0.4",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.2",
    "mongoose": "^8.0.3",
    "nanoid": "^5.0.4",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "redis": "^4.6.10",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-cloudwatch": "^6.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "axios": "^1.6.2",
    "colors": "^1.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.0",
    "fast-check": "^3.15.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "jest-html-reporters": "^3.1.5",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "testcontainers": "^10.4.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.1.3"
  }
}
