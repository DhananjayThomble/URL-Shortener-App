# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_VERSION=1.0.0

# Database Configuration
# PostgreSQL (User Management)
DATABASE_URL=postgresql://username:password@localhost:5432/url_shortener
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=username
DATABASE_PASSWORD=password
DATABASE_NAME=url_shortener

# PostgreSQL SSL Configuration (Production)
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# PostgreSQL Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000
DB_POOL_EVICT=1000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_IDLE_TIMEOUT=30000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=3000

# MongoDB (URL Management)
MONGODB_URI=mongodb://localhost:27017/url_shortener
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=url_shortener

# MongoDB Connection Pool Configuration
MONGO_POOL_MAX=20
MONGO_POOL_MIN=5
MONGO_IDLE_TIME=30000
MONGO_WAIT_TIMEOUT=10000
MONGO_SERVER_TIMEOUT=5000
MONGO_SOCKET_TIMEOUT=45000
MONGO_CONNECT_TIMEOUT=10000

# MongoDB Replica Set Configuration
MONGO_REPLICA_SET=
MONGO_READ_PREFERENCE=secondaryPreferred
MONGO_READ_CONCERN=local
MONGO_WRITE_CONCERN_W=majority
MONGO_WRITE_CONCERN_J=true
MONGO_WRITE_CONCERN_TIMEOUT=10000

# MongoDB Authentication
MONGO_AUTH_SOURCE=admin
MONGO_AUTH_MECHANISM=SCRAM-SHA-256

# MongoDB SSL Configuration (Production)
MONGO_SSL=false
MONGO_SSL_VALIDATE=true
MONGO_SSL_CA=
MONGO_SSL_CERT=
MONGO_SSL_KEY=

# MongoDB Performance Configuration
MONGO_HEARTBEAT_FREQUENCY=10000
MONGO_RETRY_WRITES=true
MONGO_RETRY_READS=true

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2
REDIS_KEY_PREFIX=urlshortener:

# Redis Connection Pool Configuration
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=true
REDIS_READY_CHECK=false
REDIS_OFFLINE_QUEUE=false
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_FAMILY=4
REDIS_KEEP_ALIVE=30000

# Redis Cluster Configuration
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=
REDIS_CLUSTER_RETRY_DELAY=100
REDIS_CLUSTER_DOWN_RETRY_DELAY=300
REDIS_CLUSTER_MAX_REDIRECTIONS=16
REDIS_CLUSTER_SCALE_READS=slave

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this-in-production

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=900000

# Monitoring and Observability Configuration
LOG_LEVEL=info
ENABLE_PROMETHEUS_TRACING=true
PROMETHEUS_METRICS_PORT=9090
JAEGER_ENDPOINT=http://localhost:14268/api/traces
ENABLE_DISTRIBUTED_TRACING=true

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_CLOUDWATCH_LOG_GROUP=url-shortener
AWS_CLOUDWATCH_LOG_STREAM=nestjs-app

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@yourapp.com

# Application URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Custom Domain Configuration
DEFAULT_DOMAIN=localhost:3000
CUSTOM_DOMAIN_ENABLED=false

# API Keys for External Integrations
VALID_API_KEYS=api-key-1,api-key-2,api-key-3

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000
DB_POOL_EVICT=1000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# MongoDB Connection Pool Configuration
MONGO_POOL_MAX=20
MONGO_POOL_MIN=5
MONGO_IDLE_TIME=30000
MONGO_WAIT_TIMEOUT=10000
MONGO_SERVER_TIMEOUT=5000
MONGO_SOCKET_TIMEOUT=45000
MONGO_CONNECT_TIMEOUT=10000

# Cache Configuration
CACHE_TTL_URL=3600
CACHE_TTL_SESSION=900
CACHE_TTL_ANALYTICS=300
CACHE_TTL_METADATA=86400
CACHE_TTL_POPULAR=1800
CACHE_TTL_DEFAULT=3600
CACHE_ENABLE_COMPRESSION=true
CACHE_ENABLE_WARMING=true
CACHE_AUTO_OPTIMIZE=true
CACHE_MAX_KEY_LENGTH=250
CACHE_MAX_VALUE_SIZE=1048576

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD=1000