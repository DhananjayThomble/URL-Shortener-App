# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@postgres:5432/urlshortener_prod
MONGODB_URI=mongodb://username:password@mongodb:27017/urlshortener_prod
REDIS_URL=redis://:password@redis:6379

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=urlshortener_prod
POSTGRES_USER=urlshortener_user
POSTGRES_PASSWORD=your_secure_postgres_password

# MongoDB Configuration
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=your_secure_mongo_password
MONGO_DATABASE=urlshortener_prod

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=urlshortener:prod:

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h

# Security Configuration
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
CLOUDWATCH_LOG_GROUP=/aws/ecs/nestjs-url-shortener
CLOUDWATCH_LOG_STREAM=nestjs-url-shortener-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Cache Configuration
CACHE_TTL_URL=3600
CACHE_TTL_SESSION=900
CACHE_TTL_ANALYTICS=300
CACHE_TTL_METADATA=86400
CACHE_TTL_POPULAR=1800
CACHE_TTL_DEFAULT=3600
CACHE_ENABLE_COMPRESSION=true
CACHE_ENABLE_WARMING=true
CACHE_AUTO_OPTIMIZE=true
CACHE_MAX_KEY_LENGTH=250
CACHE_MAX_VALUE_SIZE=1048576

# Rate Limiting Configuration
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_URL_CREATION_TTL=60000
RATE_LIMIT_URL_CREATION_MAX=10
RATE_LIMIT_URL_ACCESS_TTL=60000
RATE_LIMIT_URL_ACCESS_MAX=100

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_HELMET=true
ENABLE_CORS=true
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_DISTRIBUTED_TRACING=true
METRICS_ENDPOINT_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000

# Email Configuration (if using email features)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@yourdomain.com

# Application Configuration
APP_NAME=NestJS URL Shortener
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise URL Shortener built with NestJS
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CUSTOM_DOMAINS=true
ENABLE_LINK_IN_BIO=true
ENABLE_PASSWORD_PROTECTION=true
ENABLE_EXPIRATION=true
ENABLE_BULK_OPERATIONS=true

# Security Headers
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Graceful Shutdown Configuration
SHUTDOWN_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=5000