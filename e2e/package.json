{
  "name": "snapurl-e2e",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright end-to-end tests. Drive the dashboard in fixtures mode (NEXT_PUBLIC_USE_FIXTURES=true) — no API or database needed.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:mocked-api": "playwright test -c playwright.mocked-api.config.ts",
    "test:journeys": "playwright test -c playwright.journeys.config.ts",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:dom-xss": "playwright test -c adversarial/playwright.dom-xss.config.ts",
    "test:webkit": "playwright test -c playwright.webkit.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "install:chromium": "playwright install --with-deps chromium",
    "check:auth-volume": "node scripts/check-auth-volume.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@snapurl/database": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "axe-core": "4.10.2",
    "jsqr": "1.4.0",
    "typescript": "^5.7.3"
  }
}
