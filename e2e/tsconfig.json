{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.real.config.ts",
    "playwright.journeys.config.ts",
    "tests/**/*.ts",
    "support/**/*.ts",
    "journeys/**/*.ts"
  ]
}
