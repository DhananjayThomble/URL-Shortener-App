{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.real.config.ts",
    "playwright.journeys.config.ts",
    "playwright.a11y.config.ts",
    "playwright.mocked-api.config.ts",
    "playwright.visual.config.ts",
    "playwright.webkit.config.ts",
    "visual/**/*.ts",
    "mocked-api/**/*.ts",
    "tests/**/*.ts",
    "support/**/*.ts",
    "journeys/**/*.ts",
    "a11y/**/*.ts",
    "adversarial/**/*.ts",
    "webkit/**/*.ts"
  ]
}
