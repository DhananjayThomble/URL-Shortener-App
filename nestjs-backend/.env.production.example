# SnapURL Backend - Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
GLOBAL_PREFIX=api
API_VERSION=v1
BASE_URL=https://snapurl.com
API_BASE_URL=https://api.snapurl.com
FRONTEND_URL=https://snapurl.com
MAX_REQUEST_SIZE=10mb
TRUST_PROXY=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Primary Database)
POSTGRES_HOST=your-postgres-host.com
POSTGRES_PORT=5432
POSTGRES_USERNAME=snapurl_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DATABASE=snapurl_prod
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_SSL_CA=/path/to/ca-certificate.crt
POSTGRES_SSL_CERT=/path/to/client-certificate.crt
POSTGRES_SSL_KEY=/path/to/client-key.key
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_ACQUIRE_TIMEOUT=60000
POSTGRES_TIMEOUT=60000
POSTGRES_RECONNECT_TRIES=3
POSTGRES_RECONNECT_INTERVAL=2000
POSTGRES_LOGGING=false

# MongoDB (Analytics & Logs)
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/snapurl_prod?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME=30000
MONGODB_SERVER_SELECTION_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_CONNECT_TIMEOUT=10000
MONGODB_SSL=true
MONGODB_SSL_VALIDATE=true
MONGODB_SSL_CA=/path/to/mongodb-ca.crt
MONGODB_SSL_CERT=/path/to/mongodb-client.crt
MONGODB_SSL_KEY=/path/to/mongodb-client.key

# Redis (Caching & Sessions)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=snapurl:prod:
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3
REDIS_KEEP_ALIVE=30000
REDIS_FAMILY=4
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# Redis Cluster (if using)
REDIS_CLUSTER=false
# REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379

# Redis Sentinel (if using)
REDIS_SENTINEL=false
# REDIS_SENTINELS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=sentinel-password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_ISSUER=snapurl
JWT_AUDIENCE=snapurl-users

# Password Hashing
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=https://snapurl.com,https://www.snapurl.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-API-Key
CORS_EXPOSED_HEADERS=X-Total-Count
CORS_MAX_AGE=86400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_MESSAGE=Too many requests from this IP
RATE_LIMIT_STANDARD_HEADERS=true
RATE_LIMIT_LEGACY_HEADERS=false
RATE_LIMIT_SKIP_SUCCESSFUL=false
RATE_LIMIT_SKIP_FAILED=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Email Service
EMAIL_PROVIDER=sendgrid
# EMAIL_PROVIDER=smtp|sendgrid|ses

# SMTP Configuration (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS_REJECT_UNAUTHORIZED=true

# SendGrid Configuration (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@snapurl.com

# AWS SES Configuration (if using SES)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SES_FROM_EMAIL=noreply@snapurl.com

# GeoIP Service
GEOIP_PROVIDER=maxmind
# GEOIP_PROVIDER=maxmind|ipapi

# MaxMind Configuration (if using MaxMind)
MAXMIND_LICENSE_KEY=your-maxmind-license-key
MAXMIND_USER_ID=your-maxmind-user-id
MAXMIND_DATABASE_PATH=/opt/geoip/GeoLite2-City.mmdb
MAXMIND_UPDATE_INTERVAL=86400000

# IP-API Configuration (if using IP-API)
IPAPI_API_KEY=your-ipapi-key
IPAPI_BASE_URL=http://api.ipapi.com
IPAPI_TIMEOUT=5000

# Storage Service
STORAGE_PROVIDER=s3
# STORAGE_PROVIDER=local|s3|gcs

# Local Storage (if using local)
LOCAL_UPLOAD_PATH=/opt/snapurl/uploads
LOCAL_MAX_FILE_SIZE=10485760

# AWS S3 Configuration (if using S3)
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=snapurl-prod-uploads
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
S3_MAX_FILE_SIZE=52428800

# Google Cloud Storage (if using GCS)
GCS_PROJECT_ID=your-gcs-project-id
GCS_KEY_FILENAME=/path/to/service-account-key.json
GCS_BUCKET=snapurl-prod-uploads
GCS_MAX_FILE_SIZE=52428800

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_DEFAULT_METRICS=true
PROMETHEUS_PREFIX=snapurl_

# Grafana
GRAFANA_ENABLED=true
GRAFANA_URL=https://your-grafana-instance.com
GRAFANA_API_KEY=your-grafana-api-key
GRAFANA_DASHBOARD_ID=snapurl-dashboard

# Sentry
SENTRY_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Datadog
DATADOG_ENABLED=false
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE=snapurl-backend
DATADOG_VERSION=1.0.0
DATADOG_ENV=production

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=false

# File Logging
LOG_FILE_ENABLED=true
LOG_FILE_NAME=/var/log/snapurl/app.log
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=5
LOG_FILE_TAILABLE=true

# Elasticsearch Logging
LOG_ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOST=localhost:9200
ELASTICSEARCH_INDEX=snapurl-logs
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
ELASTICSEARCH_SSL=true

# CloudWatch Logging
LOG_CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/aws/ec2/snapurl
CLOUDWATCH_LOG_STREAM=backend
AWS_REGION=us-east-1

# =============================================================================
# PERFORMANCE & OPTIMIZATION
# =============================================================================

# Caching
CACHE_TTL=300
CACHE_MAX=1000
CACHE_UPDATE_AGE_ON_GET=true
CACHE_UPDATE_AGE_ON_HAS=true

# Clustering
CLUSTERING_ENABLED=false
CLUSTERING_WORKERS=0

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30000
GRACEFUL_SHUTDOWN_SIGNALS=SIGTERM,SIGINT

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_ANALYTICS=true
FEATURE_GEO_TARGETING=true
FEATURE_PASSWORD_PROTECTION=true
FEATURE_CUSTOM_DOMAINS=true
FEATURE_BIO_PAGES=true
FEATURE_BULK_OPERATIONS=true
FEATURE_API_RATE_LIMITING=true
FEATURE_REAL_TIME_ANALYTICS=true
FEATURE_ADVANCED_METRICS=true

# =============================================================================
# HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_INTERVAL=30000
HEALTH_LIVENESS_ENDPOINT=/health/live
HEALTH_READINESS_ENDPOINT=/health/ready
HEALTH_METRICS_ENDPOINT=/health/metrics