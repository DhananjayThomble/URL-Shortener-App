# Development Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/url_shortener_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=url_shortener_dev

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/url_shortener_dev
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=url_shortener_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=urlshortener:dev:

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-not-for-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-key-not-for-production
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=dev-session-secret-not-for-production

# Logging Configuration
LOG_LEVEL=debug
ENABLE_PROMETHEUS_TRACING=true
PROMETHEUS_METRICS_PORT=9090

# Development Features
ENABLE_SWAGGER=true
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true

# Cache Configuration (Relaxed for development)
CACHE_TTL_URL=300
CACHE_TTL_SESSION=600
CACHE_TTL_ANALYTICS=60
CACHE_ENABLE_COMPRESSION=false
CACHE_ENABLE_WARMING=false
CACHE_AUTO_OPTIMIZE=false

# Rate Limiting (Relaxed for development)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_TTL=300000
RATE_LIMIT_AUTH_MAX=20

# Email Configuration (Development - use MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=dev@localhost

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CUSTOM_DOMAINS=false
ENABLE_LINK_IN_BIO=true
ENABLE_PASSWORD_PROTECTION=true
ENABLE_EXPIRATION=true
ENABLE_BULK_OPERATIONS=true

# Development URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Debug Configuration
DEBUG_SQL=true
DEBUG_REDIS=true
DEBUG_MONGODB=true
ENABLE_QUERY_LOGGING=true

# Performance (Relaxed for development)
ENABLE_COMPRESSION=false
MAX_REQUEST_SIZE=50mb
REQUEST_TIMEOUT=60000

# Development Database Pool Configuration
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=30000

# Development Monitoring
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_DISTRIBUTED_TRACING=false
HEALTH_CHECK_TIMEOUT=10000