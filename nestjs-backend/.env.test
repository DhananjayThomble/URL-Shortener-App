# Test Environment Configuration
NODE_ENV=test
PORT=3001
API_PREFIX=api/v1
APP_VERSION=1.0.0

# Test Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5433/url_shortener_test
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=url_shortener_test

# Test MongoDB Configuration
MONGODB_URI=mongodb://localhost:27018/url_shortener_test
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_DATABASE=url_shortener_test

# Test Redis Configuration
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=urlshortener:test:

# JWT Configuration (Test values)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
JWT_REFRESH_EXPIRES_IN=24h

# Security Configuration (Relaxed for testing)
BCRYPT_SALT_ROUNDS=4
SESSION_SECRET=test-session-secret-for-testing-only

# Logging Configuration (Minimal for testing)
LOG_LEVEL=error
ENABLE_PROMETHEUS_TRACING=false
PROMETHEUS_METRICS_PORT=9091

# Disable external services for testing
ENABLE_SWAGGER=false
ENABLE_CORS=true
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Cache Configuration (Disabled for testing)
CACHE_TTL_URL=0
CACHE_TTL_SESSION=0
CACHE_TTL_ANALYTICS=0
CACHE_ENABLE_COMPRESSION=false
CACHE_ENABLE_WARMING=false
CACHE_AUTO_OPTIMIZE=false

# Rate Limiting (Disabled for testing)
RATE_LIMIT_TTL=0
RATE_LIMIT_MAX=0
RATE_LIMIT_AUTH_TTL=0
RATE_LIMIT_AUTH_MAX=0

# Email Configuration (Mock for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test
EMAIL_FROM=test@localhost

# Feature Flags (All enabled for comprehensive testing)
ENABLE_ANALYTICS=true
ENABLE_CUSTOM_DOMAINS=true
ENABLE_LINK_IN_BIO=true
ENABLE_PASSWORD_PROTECTION=true
ENABLE_EXPIRATION=true
ENABLE_BULK_OPERATIONS=true

# Test URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001
BASE_URL=http://localhost:3001

# Performance (Optimized for test speed)
ENABLE_COMPRESSION=false
MAX_REQUEST_SIZE=1mb
REQUEST_TIMEOUT=5000

# Test Database Pool Configuration (Minimal)
DB_POOL_MIN=1
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT=5000
DB_POOL_ACQUIRE_TIMEOUT=10000

# Test Monitoring (Disabled)
ENABLE_METRICS=false
ENABLE_HEALTH_CHECKS=true
ENABLE_DISTRIBUTED_TRACING=false
HEALTH_CHECK_TIMEOUT=2000

# Test-specific Configuration
TEST_TIMEOUT=30000
JEST_TIMEOUT=30000
ENABLE_TEST_LOGGING=false
PARALLEL_TESTS=true

# Graceful Shutdown (Fast for testing)
SHUTDOWN_TIMEOUT=1000
KEEP_ALIVE_TIMEOUT=500