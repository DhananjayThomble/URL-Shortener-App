# Staging Environment Configuration
NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://urlshortener_user:CHANGE_ME_IN_STAGING@postgres-staging:5432/url_shortener_staging
DATABASE_HOST=postgres-staging
DATABASE_PORT=5432
DATABASE_USERNAME=urlshortener_user
DATABASE_PASSWORD=CHANGE_ME_IN_STAGING
DATABASE_NAME=url_shortener_staging

# MongoDB Configuration
MONGODB_URI=mongodb://root:CHANGE_ME_IN_STAGING@mongodb-staging:27017/url_shortener_staging?authSource=admin
MONGODB_HOST=mongodb-staging
MONGODB_PORT=27017
MONGODB_DATABASE=url_shortener_staging

# Redis Configuration
REDIS_URL=redis://:CHANGE_ME_IN_STAGING@redis-staging:6379
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_STAGING
REDIS_DB=0
REDIS_KEY_PREFIX=urlshortener:staging:

# JWT Configuration
JWT_SECRET=CHANGE_ME_IN_STAGING_MINIMUM_32_CHARACTERS_LONG
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_IN_STAGING_REFRESH_SECRET_MINIMUM_32_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h

# Security Configuration
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=CHANGE_ME_IN_STAGING_SESSION_SECRET
CORS_ORIGIN=https://staging.yourdomain.com,https://staging-api.yourdomain.com
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
CLOUDWATCH_LOG_GROUP=/aws/staging/nestjs-url-shortener
CLOUDWATCH_LOG_STREAM=nestjs-url-shortener-staging
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_IN_STAGING
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IN_STAGING

# Cache Configuration
CACHE_TTL_URL=1800
CACHE_TTL_SESSION=900
CACHE_TTL_ANALYTICS=300
CACHE_TTL_METADATA=43200
CACHE_TTL_POPULAR=1800
CACHE_TTL_DEFAULT=1800
CACHE_ENABLE_COMPRESSION=true
CACHE_ENABLE_WARMING=true
CACHE_AUTO_OPTIMIZE=true
CACHE_MAX_KEY_LENGTH=250
CACHE_MAX_VALUE_SIZE=1048576

# Rate Limiting Configuration
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_TTL=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_URL_CREATION_TTL=60000
RATE_LIMIT_URL_CREATION_MAX=20
RATE_LIMIT_URL_ACCESS_TTL=60000
RATE_LIMIT_URL_ACCESS_MAX=200

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_HELMET=true
ENABLE_CORS=true
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_DISTRIBUTED_TRACING=true
METRICS_ENDPOINT_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000
ENABLE_PROMETHEUS_TRACING=true
PROMETHEUS_METRICS_PORT=9090

# Email Configuration
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging@yourdomain.com
SMTP_PASS=CHANGE_ME_IN_STAGING
EMAIL_FROM=noreply-staging@yourdomain.com

# Application Configuration
APP_NAME=NestJS URL Shortener (Staging)
APP_DESCRIPTION=Enterprise URL Shortener built with NestJS - Staging Environment
BASE_URL=https://staging.yourdomain.com
FRONTEND_URL=https://staging.yourdomain.com
BACKEND_URL=https://staging-api.yourdomain.com

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CUSTOM_DOMAINS=true
ENABLE_LINK_IN_BIO=true
ENABLE_PASSWORD_PROTECTION=true
ENABLE_EXPIRATION=true
ENABLE_BULK_OPERATIONS=true

# Security Headers
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=8
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Graceful Shutdown Configuration
SHUTDOWN_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=5000

# Staging-specific debugging
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD=500