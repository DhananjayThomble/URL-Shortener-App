# Compose STAGING environment — copy to .env.staging (git-ignored) and edit.
#
#   cp .env.staging.example .env.staging
#
# EVERY value here has a safe default baked into docker-compose.staging.yml, so
# the stack comes up with NO .env.staging present. This file exists to (a)
# document the knobs and (b) let you override them without editing the compose
# file. NOTHING here is a real secret — these are throwaway staging values. Do
# NOT put production secrets in .env.staging; it is git-ignored precisely so a
# real secret cannot be committed by accident, but the values below are safe to
# read and are only ever used against a local, disposable database.

# ── Postgres (staging is data-isolated on host port 5435, volume
#    snapurl-staging-pgdata — see docker-compose.staging.yml) ──────────────────
POSTGRES_USER=snapurl
POSTGRES_PASSWORD=snapurl
POSTGRES_DB=snapurl

# ── JWT signing secrets ──────────────────────────────────────────────────────
# These MUST be identical for api and redirect (both read JWT_ACCESS_SECRET), or
# unlock tokens for password-protected links verify on one service and fail on
# the other. Each must be ≥32 characters or the API's zod env schema aborts at
# boot. Throwaway staging values — regenerate freely (e.g. `openssl rand -hex 24`).
JWT_ACCESS_SECRET=staging-compose-access-secret-0000000000
JWT_REFRESH_SECRET=staging-compose-refresh-secret-000000000

# ── Origins / domains ────────────────────────────────────────────────────────
# WEB_ORIGIN is where the dashboard runs (web is run on the HOST via
# `pnpm dev:web`, decision D1 — there is no web container). DEFAULT_DOMAIN and
# REDIRECT_ORIGIN point new links + the redirect service at the staging redirect
# on localhost:3002, which the smoke scripts create links on and follow.
WEB_ORIGIN=http://localhost:3000
DEFAULT_DOMAIN=localhost:3002
REDIRECT_ORIGIN=http://localhost:3002

# ── Web (run on the HOST, not containerised) ─────────────────────────────────
# This is NOT read by the compose stack — it documents what to export when you
# start web against staging:
#
#   NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1 pnpm dev:web
#
# In dev mode (`pnpm dev:web`) the next.config.ts production guard is inert, so
# a localhost API URL is fine — the browser runs on the same host that publishes
# api:3001. For a production `next build`/`next start`, the guard rejects a
# localhost value and you must use a non-localhost name the browser can reach.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Adapters (informational — do NOT set these for compose staging) ──────────
# Staging uses the Postgres/in-memory adapter set (same as single-node,
# Profile 1). LINK_PROJECTION and CLICK_SINK are left UNSET so the redirect
# resolves link config from Postgres and clicks INSERT into Postgres, and
# CACHE_DRIVER=memory (set in the compose file). Setting LINK_PROJECTION=dynamo
# / CLICK_SINK=sqs would require real AWS resources and is out of scope for
# compose staging — those adapters, plus the CloudFront/Lambda edge (KVS fast
# path, OAC invoke grant, viewer-country header, edge query-string merge) and
# SES mail, are covered ONLY by the deployed smoke test against prod, never here.
