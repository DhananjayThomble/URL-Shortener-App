{
  "name": "@snapurl/api",
  "version": "2.0.0",
  "private": true,
  "description": "SnapURL dashboard API. Serves the contract in @snapurl/contract over HTTP.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:nest": "nest start --watch"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@snapurl/cache": "workspace:*",
    "@snapurl/contract": "workspace:*",
    "@snapurl/database": "workspace:*",
    "@snapurl/domain": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^5.11.3",
    "nestjs-pino": "^4.4.1",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/node": "^22",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
