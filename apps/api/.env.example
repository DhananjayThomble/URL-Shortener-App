# Copy to .env and fill in. The API refuses to start if anything here is invalid.
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

DATABASE_URL=postgres://snapurl:snapurl@localhost:5433/snapurl
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Two different secrets. One key signing both would let a stolen access token
# be replayed as a refresh token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-32-plus-random-characters-aaaa
JWT_REFRESH_SECRET=change-me-to-a-different-32-plus-value-bbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

WEB_ORIGIN=http://localhost:3000
DEFAULT_DOMAIN=localhost:3002
REDIRECT_ORIGIN=http://localhost:3002

# Without this, links are marked "clean" without being scanned while the UI
# claims they were checked. See docs/DECISIONS.md A10.
# GOOGLE_SAFE_BROWSING_API_KEY=

MAIL_TRANSPORT=outbox
MAIL_FROM=SnapURL <no-reply@snapurl.local>

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
LOG_LEVEL=debug
