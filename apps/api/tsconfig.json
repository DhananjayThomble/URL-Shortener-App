{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "baseUrl": "./",
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"],
  // Test-only stack files import dev dependencies / are consumed only by tests,
  // so they must not land in the production build — excluded alongside the test
  // files (the matching *.test.ts are already covered by the glob):
  //   zod-arbitrary.ts (#889, fast-check), env.ts + principals.ts (#888 harness),
  //   access-matrix.expected.ts (#891 oracle), resources.ts (#892 seeder).
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/stack/zod-arbitrary.ts",
    "src/stack/env.ts",
    "src/stack/principals.ts",
    "src/stack/access-matrix.expected.ts",
    "src/stack/resources.ts"
  ]
}
