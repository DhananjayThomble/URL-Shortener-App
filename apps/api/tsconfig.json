{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "baseUrl": "./",
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"],
  // src/stack/zod-arbitrary.ts imports fast-check (a devDependency) and is only
  // consumed by tests, so it must not land in the production build — exclude it
  // alongside the test files. (The matching test is already covered by the
  // src/**/*.test.ts glob.)
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/stack/zod-arbitrary.ts"]
}
