{
  "name": "@snapurl/redirect",
  "version": "2.0.0",
  "private": true,
  "description": "The redirect hot path. Deliberately not NestJS — it carries the least of any app here.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --watch dist/main.js",
    "start": "node --env-file=.env dist/main.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@snapurl/contract": "workspace:*",
    "@snapurl/database": "workspace:*",
    "@snapurl/domain": "workspace:*",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "argon2": "^0.44.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
