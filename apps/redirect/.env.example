PORT=3002
DATABASE_URL=postgres://snapurl:snapurl@localhost:5433/snapurl
# Optional read replica. When absent, reads use the primary (single-node
# behaviour unchanged). The redirect always uses the primary for the click gate
# regardless, but this is plumbed through for consistency.
# DATABASE_REPLICA_URL=
# DATABASE_SSL=true now VERIFIES the server certificate (verify-full) by default.
DATABASE_SSL=false
# CA bundle (PEM) to verify against, for RDS/self-signed.
# DATABASE_CA_CERT=
# Opt out of verification. VPC only; insecure across untrusted networks.
# DATABASE_SSL_NO_VERIFY=false
# Must match the API — the redirect verifies unlock tokens the API signed.
JWT_ACCESS_SECRET=
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Number of proxies in front of the redirect that APPEND their edge IP to
# X-Forwarded-For. visitorHash is derived from the (TRUSTED_PROXY_HOPS+1)th
# entry from the right of that chain, so a client-supplied header cannot forge
# visitor identity. 0 = local dev and compose (service hit directly with no
# X-Forwarded-For). Production behind CloudFront sets it to 1 (or higher for
# additional appending hops).
TRUSTED_PROXY_HOPS=0

# postgres = read link config straight from Postgres (local dev, self-hosting).
# dynamo   = read the projection the API writes (production, and what the
#            architecture is designed around).
LINK_RESOLVER=postgres
CLICK_SINK=postgres
