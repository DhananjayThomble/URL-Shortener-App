{
  "name": "@snapurl/domain",
  "version": "2.0.0",
  "private": true,
  "description": "Pure business logic: routing chain evaluation, slug generation, cookieless visitor hashing. No I/O, no framework.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./expiry": {
      "types": "./dist/expiry.d.ts",
      "default": "./dist/expiry.js"
    },
    "./destination": {
      "types": "./dist/destination.d.ts",
      "default": "./dist/destination.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./initials": {
      "types": "./dist/initials.d.ts",
      "default": "./dist/initials.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@snapurl/contract": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "fast-check": "^4.9.0"
  }
}
